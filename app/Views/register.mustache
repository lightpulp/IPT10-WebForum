{{< layout}}
{{$title}}Create an account{{/title}}
{{$content}}
<section class="narrow">
  <h1>Create an account</h1>
  {{#hasErrors}}
  <ul class="form-errors" role="alert">
    {{#errors}}<li>{{.}}</li>{{/errors}}
  </ul>
  {{/hasErrors}}
  <form method="post" action="{{base}}/register" class="stack">
    <input type="hidden" name="csrf_token" value="{{csrf}}">
    <label for="username">Username</label>
    <input id="username" name="username" type="text" value="{{old.username}}" minlength="3" maxlength="30"
           pattern="[A-Za-z0-9_]+" autocomplete="username" required>
    <p class="hint">3 to 30 letters, numbers or underscores.</p>
    <label for="email">Email</label>
    <input id="email" name="email" type="email" value="{{old.email}}" maxlength="254" autocomplete="email" required>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" minlength="8" maxlength="72" autocomplete="new-password" required>
    <p class="hint">At least 8 characters.</p>
    <label for="password_confirm">Repeat password</label>
    <input id="password_confirm" name="password_confirm" type="password" minlength="8" maxlength="72" autocomplete="new-password" required>
    <button type="submit" class="button">Create account</button>
  </form>
  <p>Already registered? <a href="{{base}}/login">Log in</a>.</p>
</section>
{{/content}}
{{/layout}}
