{{< layout}}
{{$title}}Log in{{/title}}
{{$content}}
<section class="narrow">
  <h1>Log in</h1>
  {{#hasErrors}}
  <ul class="form-errors" role="alert">
    {{#errors}}<li>{{.}}</li>{{/errors}}
  </ul>
  {{/hasErrors}}
  <form method="post" action="{{base}}/login" class="stack">
    <input type="hidden" name="csrf_token" value="{{csrf}}">
    {{#next}}<input type="hidden" name="next" value="{{next}}">{{/next}}
    <label for="login">Username or email</label>
    <input id="login" name="login" type="text" value="{{old.login}}" autocomplete="username" required>
    <label for="password">Password</label>
    <input id="password" name="password" type="password" autocomplete="current-password" required>
    <button type="submit" class="button">Log in</button>
  </form>
  <p>No account yet? <a href="{{base}}/register">Register</a>.</p>
</section>
{{/content}}
{{/layout}}
